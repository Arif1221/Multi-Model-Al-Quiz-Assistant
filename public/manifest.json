{
  "manifest_version": 3,
  "name": "StudyPilot AI",
  "description": "AI-powered Chrome study assistant with automatic quiz detection and multi-model answer reliability.",
  "version": "0.1.0",
  "action": {
    "default_title": "Open StudyPilot AI"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "sidePanel", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>", "https://openrouter.ai/*"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
